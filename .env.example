# =============================================================================
# Supabase (required)
# =============================================================================
# Client-side (safe to expose — anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER expose to frontend (do NOT prefix with VITE_)
# Used by Vercel serverless functions (/api/*) and local Express dev server
SUPABASE_SERVICE_KEY=your-service-role-key

# =============================================================================
# Local dev (Express server) — not used in Vercel production
# =============================================================================
PORT=3001
NODE_ENV=development

# =============================================================================
# Vercel deployment notes
# =============================================================================
# Set the following in Vercel Dashboard → Project → Settings → Environment Variables:
#   VITE_SUPABASE_URL        (Production, Preview, Development)
#   VITE_SUPABASE_ANON_KEY   (Production, Preview, Development)
#   SUPABASE_SERVICE_KEY     (Production, Preview, Development) — Sensitive
# PORT / NODE_ENV are NOT required on Vercel (managed by the platform).
